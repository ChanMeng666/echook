{
  "_comment": "Codex plugin hooks template for audio-hooks. This file is loaded by the Codex plugin manifest and uses ${PLUGIN_ROOT} so it stays relocatable inside the Codex plugin cache.",
  "_schema_doc": "https://learn.chatgpt.com/docs/hooks",
  "_audio_hooks_managed": true,
  "_audio_hooks_version": "6.8.0",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/runner/run.py\" session_start --invoker codex",
            "timeout": 10,
            "statusMessage": "audio-hooks: session start",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/runner/run.py\" pretooluse --invoker codex",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/runner/run.py\" permission_request --invoker codex",
            "timeout": 10,
            "statusMessage": "audio-hooks: permission request",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/runner/run.py\" posttooluse --invoker codex",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/runner/run.py\" precompact --invoker codex",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/runner/run.py\" precompact --invoker codex",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/runner/run.py\" postcompact --invoker codex",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/runner/run.py\" postcompact --invoker codex",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/runner/run.py\" userpromptsubmit --invoker codex",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/runner/run.py\" subagent_start --invoker codex",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/runner/run.py\" subagent_stop --invoker codex",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/runner/run.py\" stop --invoker codex",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  },
  "_async_note": "v6.5: every handler is async. echook's hooks are pure side effects -- they play a sound, speak, or POST a webhook and never approve, deny or rewrite anything -- which is exactly the workload Codex's async hooks exist for (0.148.0, #37533). Codex allows up to 8 concurrent async hooks per session. The `commandWindows` field is deliberately unused: `audio-hooks install --codex` generates this file per machine and already substitutes a correctly escaped native path, so a second Windows command would add a surface to keep in sync for no benefit."
}
